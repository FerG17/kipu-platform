{
  "TokenSettings": {
    "Secret": "%BODEGA_JWT_SECRET%",
    "ExpirationDays": 1
  },
  "Bootstrap": {
    "Key": "%BODEGA_BOOTSTRAP_KEY%"
  },
  "Resend": {
    "ApiKey": "%RESEND_API_KEY%",
    "FromEmail": "%RESEND_FROM_EMAIL%",
    "FromName": "Kipu"
  },
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;user=root;password=%BODEGA_DB_PASSWORD%;database=kipu_platform"
  },
  "Business": {
    "TimeZone": "America/Lima"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
