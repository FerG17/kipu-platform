{
  "TokenSettings": {
    "Secret": "%BODEGA_JWT_SECRET%",
    "ExpirationDays": 1
  },
  "Bootstrap": {
    "Key": "%BODEGA_BOOTSTRAP_KEY%"
  },
  "ConnectionStrings": {
    "DefaultConnection": "%BODEGA_DB_CONNECTION_STRING%"
  },
  "Business": {
    "TimeZone": "America/Lima"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "TrustLastProxyHop": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
