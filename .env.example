# Copy to .env (untracked) and fill in. Compose reads .env automatically; the
# integration test suite reads it too, so `docker compose up` and `dotnet test`
# both work with nothing else set up.
#
# These are local development values — they never leave your machine and are
# not the production ones. Production takes its configuration from real
# environment variables (BODEGA_JWT_SECRET, BODEGA_DB_CONNECTION_STRING).

# Root password for the local MySQL container (compose.yaml) and for the
# database the test suite talks to.
BODEGA_DB_PASSWORD=change-me

# Only needed to run the app itself via `docker compose up` (not for
# `dotnet test`, which talks to MySQL directly). The container runs with no
# ASPNETCORE_ENVIRONMENT set, so it loads appsettings.Production.json and
# needs these filled in — any value works locally, they just need to be set.
BODEGA_JWT_SECRET=change-me-to-a-long-random-string
BODEGA_BOOTSTRAP_KEY=change-me-to-a-long-random-string
